# INAKTIVE VORLAGE. Erst nach ausdrücklicher Websitefreigabe nach
# .github/workflows/pages.yml kopieren und GitHub Pages konfigurieren.
# Veröffentlichungen ausschließlich durch einen Push auf main.
name: Website veröffentlichen

on:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: github-pages-production
  cancel-in-progress: false

jobs:
  build:
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    runs-on: ubuntu-latest
    env:
      SDI_BASE: /sdi-website/
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-node@v7
        with:
          node-version: '26.13.1'
          cache: npm
      - run: npm ci
      - run: npm run check
      - run: npm run build
      - run: npm run check:links
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v4
        with:
          path: dist

  deploy:
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Geprüfte Websiteausgabe veröffentlichen
        id: deployment
        uses: actions/deploy-pages@v4
