---
import { imageSize } from "../lib/images.js";
import { url } from '../lib/paths.js';
const {project}=Astro.props;
---
<article class="project-card"><a class="project-image" href={url('projekte/'+project.slug+'/')} tabindex="-1" aria-hidden="true"><img src={url(project.image)} alt="" loading="lazy" {...imageSize(project.image)}/><span class:list={['status',{'status-preparing':project.slug==='suedsudan'}]}>{project.status}</span></a><div class="project-card-body"><p class="eyebrow">{project.location}</p><h3><a href={url('projekte/'+project.slug+'/')}>{project.name}</a></h3><p>{project.summary}</p><div class="project-card-links"><a class="text-link" href={url('projekte/'+project.slug+'/')}>Projekt kennenlernen</a><a class="text-link" href={url('galerie/'+project.slug+'/')}>Fotogalerie</a></div></div></article>
