---
import { imageSize } from "../../lib/images.js";
import Base from '../../layouts/Base.astro';
import galleries from '../../data/galleries.json';
import projects from '../../data/projects.json';
import {url} from '../../lib/paths.js';
---
<Base title="Galerie"><section class="page-heading"><div class="container"><div class="breadcrumb"><a href={url()}>Start</a><span>/</span>Galerie</div><p class="eyebrow">Einblicke vor Ort</p><h1>Begegnungen.<br/>Orte. Geschichten.</h1><p class="lead">Entdecken Sie unsere Projektbilder nach Ländern. Die Aufnahmen zeigen langjährige Zusammenarbeit in Kamerun und Uganda sowie die ersten Erkundungen im Südsudan.</p></div></section><section class="container section"><div class="section-head"><div><p class="eyebrow">Galerien nach Ländern</p><h2>Ein Land auswählen.</h2></div><p>{galleries.reduce((sum,g)=>sum+g.photos.length,0)} ausgewählte Aufnahmen aus dem vorhandenen Projektmaterial. Mit einem Klick lassen sich die Fotos vergrößern.</p></div><div class="project-grid">{galleries.map(gallery=><article class="project-card"><a class="project-image" href={url('galerie/'+gallery.slug+'/')} tabindex="-1" aria-hidden="true"><img src={url(projects.find(p=>p.slug===gallery.slug).image)} alt="" loading="lazy" {...imageSize(projects.find(p=>p.slug===gallery.slug).image)}/><span class:list={['status',{'status-preparing':gallery.slug==='suedsudan'}]}>{gallery.status}</span></a><div class="project-card-body"><p class="eyebrow">{gallery.photos.length} Aufnahmen</p><h3><a href={url('galerie/'+gallery.slug+'/')}>{gallery.name}</a></h3><p>{gallery.slug==='suedsudan'?'Begegnungen und bestehende Infrastruktur bei den Erkundungsbesuchen.':gallery.slug==='uganda'?'Klinikentwicklung, Technik, Labor und gemeinsame Begegnungen in Mukono.':'Historische Einblicke in die Kliniken und die Zusammenarbeit vor Ort.'}</p><a class="button button-secondary" href={url('galerie/'+gallery.slug+'/')}>Galerie ansehen</a></div></article>)}</div></section></Base>
