---
import Base from '../../layouts/Base.astro';import Gallery from '../../components/Gallery.astro';import galleries from '../../data/galleries.json';import {url} from '../../lib/paths.js';
export function getStaticPaths(){return galleries.map(gallery=>({params:{slug:gallery.slug},props:{gallery}}));}
const {gallery}=Astro.props;
---
<Base title={'Galerie '+gallery.name}><section class="page-heading"><div class="container"><div class="breadcrumb"><a href={url()}>Start</a><span>/</span><a href={url('galerie/')}>Galerie</a><span>/</span>{gallery.name}</div><p class="eyebrow">{gallery.status} · {gallery.photos.length} Aufnahmen</p><h1>Einblicke aus {gallery.name}.</h1><p class="lead">{gallery.intro}</p></div></section><section class="container section"><div class="country-tabs" role="group" aria-label="Galerie nach Land auswählen"><a href={url('galerie/')}>Alle Länder</a>{galleries.map(g=><a href={url('galerie/'+g.slug+'/')} aria-current={g.slug===gallery.slug?'page':undefined}>{g.name}<span>{g.photos.length}</span></a>)}</div><Gallery images={gallery.photos}/><div class="downloads-callout"><div><p class="eyebrow">Die Geschichte dazu</p><h3>Mehr über {gallery.name}.</h3><p>Lesen Sie den Hintergrund, den Projektstatus und die dokumentierten Meilensteine.</p></div><a class="button button-secondary" href={url('projekte/'+gallery.slug+'/')}>Projektinformationen</a></div></section></Base>
