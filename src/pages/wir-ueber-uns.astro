---
import { imageSize } from "../lib/images.js";
import Base from '../layouts/Base.astro';import Support from '../components/Support.astro';import team from '../data/team.json';import {url} from '../lib/paths.js';
---
<Base title="Wir über uns"><section class="page-heading"><div class="container"><div class="breadcrumb"><a href={url()}>Start</a><span>/</span>Wir über uns</div><p class="eyebrow">SDI Deutschland</p><h1>Persönliches Engagement.<br/>Gemeinsame Verantwortung.</h1><p class="lead">Wir unterstützen zahnmedizinische und humanitäre Versorgung, Ausbildung und Vorsorge. Im Mittelpunkt steht die Zusammenarbeit mit Menschen vor Ort.</p></div></section>
<section class="container section"><div class="split"><div><p class="eyebrow">Unsere Geschichte</p><h2>Seit 1986<br/>gemeinsam engagiert.</h2><p>Der deutsche Verein wurde am 22. Dezember 1999 gegründet. Initiatoren waren Annelie und Armin Reinartz und Peter Mentges.</p><p>Die Zusammenarbeit mit SDI Schweiz und die Unterstützung seiner Projekte sind in den deutschen Vereinsunterlagen dokumentiert. Gemeinsam verbindet uns der Einsatz für zahnmedizinische Versorgung und Vorsorge.</p><a class="text-link" href="https://www.secoursdentaire.ch/" rel="external">SDI Schweiz kennenlernen (extern)</a></div><img src={url('images/montreux.webp')} class="history-photo" alt="Gruppenfoto beim SDI-Treffen in Montreux 2026" loading="lazy" {...imageSize('images/montreux.webp')}/></div><div class="steps"><article class="step"><h3>Versorgung</h3><p>Zahnärztliche und humanitäre Hilfe für Kinder und Erwachsene ermöglichen und unterstützen.</p></article><article class="step"><h3>Ausbildung</h3><p>Wissen und praktische Erfahrung teilen und die medizinische und zahnmedizinische Ausbildung fördern.</p></article><article class="step"><h3>Vorsorge</h3><p>Prophylaxe und Gesundheitserziehung in Schulen und in der Bevölkerung unterstützen.</p></article></div></section>
<section class="section section-soft"><div class="container"><p class="eyebrow">Menschen hinter SDI</p><h2>Ihre Ansprechpartner.</h2><div class="team-grid">{team.map(person=><article class="team-card">{person.image&&<img src={url(person.image)} alt={person.name} loading="lazy" {...imageSize(person.image)}/>}<h3>{person.name}</h3><div class="person-description"><p>{person.responsibility}</p><p>Gründungsmitglied von SDI Deutschland</p><p>Seit {person.name === "Dr. Peter Mentges" ? "1990" : "1991"} für SDI Schweiz tätig</p></div><p class="contact-email">{person.email}</p></article>)}</div><p class="source-note">Die Ansprechpartner begleiten die Zusammenarbeit von SDI Deutschland mit den Partnern vor Ort.</p></div></section><Support/></Base>

<style>.split > .history-photo{aspect-ratio:auto;object-fit:contain}.person-description p + p{margin-top:.55rem}</style>
