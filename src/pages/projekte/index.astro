---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Support from '../../components/Support.astro';
import projects from '../../data/projects.json';
import {url} from '../../lib/paths.js';
---
<Base title="Unsere Projekte"><section class="page-heading"><div class="container"><div class="breadcrumb"><a href={url()}>Start</a><span>/</span>Projekte</div><p class="eyebrow">Zusammenarbeit vor Ort</p><h1>Drei Orte.<br/>Unterschiedliche Geschichten.</h1><p class="lead">In Kamerun und Uganda bestehen langjährige Projekte. Im Südsudan erkunden wir gemeinsam mit Partnern die Möglichkeiten einer künftigen Zusammenarbeit.</p></div></section><section class="container section"><div class="project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div><div class="downloads-callout"><div><h3>Interesse an einer Mitarbeit?</h3><p>Wir freuen uns auf Ihre Anfrage. Voraussetzungen, Möglichkeiten und Zeiträume klären wir persönlich für das jeweilige Projekt.</p></div><a class="button button-secondary" href={url('mitmachen/')}>Mitarbeit anfragen</a></div></section><Support/></Base>
