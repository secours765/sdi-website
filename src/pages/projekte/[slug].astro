---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import Support from '../../components/Support.astro';
import projects from '../../data/projects.json';
import timeline from '../../data/timeline.json';
import {url} from '../../lib/paths.js';

export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;
const events=timeline[project.timelineKey]||[];
---
<Base title={project.name} description={project.intro}><div class="container"><div class="breadcrumb" style="margin-top:30px"><a href={url()}>Start</a><span>/</span><a href={url('projekte/')}>Projekte</a><span>/</span>{project.name}</div><section class="project-hero"><div><p class="eyebrow">{project.location}</p><span class:list={['status',{'status-preparing':project.slug==='suedsudan'}]}>{project.status}</span><h1>{project.name}</h1><p class="lead">{project.intro}</p><a class="button button-secondary" style="margin-top:25px" href={url('galerie/'+project.slug+'/')}>Fotogalerie ansehen</a></div><figure><img src={url(project.image)} alt={project.imageCaption} width="1100" height="750" fetchpriority="high"/><figcaption>{project.imageCaption}</figcaption></figure></section></div>
<section class="section section-soft"><div class="container content-grid"><div class="prose"><p class="eyebrow">Hintergrund</p><h2>Eine Partnerschaft vor Ort.</h2><p>{project.background}</p><h2>{project.currentLabel}</h2><p>{project.current}</p>{project.slug==='suedsudan'&&<div class="notice">Die Erkundungsfotos zeigen bestehende Räume und Begegnungen. Sie belegen keine abgeschlossene Umsetzung oder Eröffnung durch SDI.</div>}</div><aside class="sidebar-box"><h2>Das Projekt in Bildern.</h2><p>Entdecken Sie weitere Aufnahmen und Hintergründe in der Galerie zu {project.name}.</p><a class="button button-secondary" href={url('galerie/'+project.slug+'/')}>Zur Länder-Galerie</a><a class="text-link" style="display:block;margin-top:22px" href={url('spenden/')}>SDI mit einer Spende unterstützen</a></aside></div></section>
<section class="container section" id="geschichte"><p class="eyebrow">Entwicklungsgeschichte</p><h2>{project.slug==='suedsudan'?'Der Anfang einer Geschichte.':'Schritt für Schritt gewachsen.'}</h2><p style="max-width:720px;margin-top:22px">Die Meilensteine beruhen auf den bereitgestellten Projektunterlagen. Zeitangaben beziehen sich auf die beschriebenen Ereignisse; bei Bildern ist ein gesonderter Hinweis zum Aufnahmekontext angegeben.</p><div class="timeline">{events.map(event=><article class="timeline-item"><div class="timeline-year">{event.period}</div><div class="timeline-content"><h3>{event.title}</h3><p>{event.text}</p>{event.webImage&&<figure><img src={url(event.webImage)} alt={event.imageContext||event.title} loading="lazy" width="1100" height="750"/><figcaption>{event.imageContext}</figcaption></figure>}<p class="source-note">Quelle: {event.sources.join('; ')}</p></div></article>)}</div></section>
<section class="section section-soft"><div class="container"><p class="eyebrow">Einblicke vor Ort</p><h2>Bilder aus {project.name}.</h2><Gallery images={project.gallery}/><a class="button button-secondary" style="margin-top:30px" href={url('galerie/'+project.slug+'/')}>Alle Fotos aus {project.name}</a></div></section><Support/></Base>
