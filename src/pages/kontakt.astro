---
import Base from '../layouts/Base.astro';import {url} from '../lib/paths.js';import team from '../data/team.json';
---
<Base title="Kontakt"><section class="page-heading"><div class="container"><div class="breadcrumb"><a href={url()}>Start</a><span>/</span>Kontakt</div><p class="eyebrow">SDI Deutschland</p><h1>Unsere Kontaktdaten.</h1><p class="lead">Ansprechpartner und Postanschrift des Vereins.</p></div></section><section class="container section"><div class="contact-grid">{team.map(person=><article class="contact-card"><h2>{person.name}</h2><p>{person.role}</p><p class="contact-email">{person.email}</p></article>)}</div><div class="prose" style="margin-top:45px"><h2>Postanschrift</h2><p>SDI Deutschland<br/>Donnersbergstraße 6<br/>67117 Limburgerhof</p><p class="source-note">Anschrift am 27. November 2026 bestätigt.</p></div></section></Base>
