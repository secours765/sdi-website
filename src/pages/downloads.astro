---
import Base from '../layouts/Base.astro';
import catalog from '../data/downloads.json';
import {url} from '../lib/paths.js';
const languages={'fr':'Französisch','en':'Englisch','de':'Deutsch','it':'Italienisch','multi':'Mehrsprachig','unknown':'Nicht angegeben','mehrsprachig':'Mehrsprachig','unbekannt':'Nicht angegeben','es':'Spanisch','sw':'Swahili','fr/en':'Französisch / Englisch','fr/de':'Französisch / Deutsch','de/fr/en':'Deutsch / Französisch / Englisch'};
const languageName=code=>languages[code]||code;
const categories=[...new Set(catalog.map(d=>d.category))].sort((a,b)=>a.localeCompare(b,'de'));
const languageCodes=[...new Set(catalog.map(d=>d.language))].sort();
const size=bytes=>bytes==null?'Größe nicht verfügbar':bytes<1024*1024?new Intl.NumberFormat('de-DE',{maximumFractionDigits:0}).format(bytes/1024)+' KB':new Intl.NumberFormat('de-DE',{maximumFractionDigits:1}).format(bytes/1024/1024)+' MiB';
const location=d=>d.availability==='local'?'Download von dieser Website':d.availability==='release'?'Download von GitHub':d.availability==='protected'?'Passwortgeschützt':d.availability==='unavailable'?'Quelle nicht erreichbar':'Originalquelle: SDI Schweiz';
---
<Base title="Downloads" description="Durchsuchbare SDI-Dokumentation: Grundlagen, Klinikhandbücher, Prophylaxe, Poster, Berichte und historische Dokumente mit Quellen, Sprache und Dateigröße.">
<section class="page-heading"><div class="container"><div class="breadcrumb"><a href={url()}>Start</a><span>/</span>Downloads</div><p class="eyebrow">Dokumentation & Wissen</p><h1>Wissen teilen.<br/>Zusammenarbeit stärken.</h1><p class="lead">Handbücher, Prophylaxematerialien und Berichte aus dem Schweizer SDI-Archiv. Finden Sie passende Dokumente nach Thema und Sprache.</p></div></section>
<section class="container section"><div class="download-intro"><p><strong>{catalog.length} Dokumentverweise · Inventur vom 27. November 2026</strong></p><p>Die Sammlung enthält Schweizer und historische Unterlagen. Angaben zu Konten, Personen und medizinischen Verfahren können veraltet sein. Für Spenden an SDI Deutschland gilt ausschließlich unsere <a href={url('spenden/')}>deutsche Spendenseite</a>.</p><details style="margin-top:14px"><summary>Über Herkunft und Bereitstellung</summary><p>Die <a href="https://www.secoursdentaire.ch/more.html" rel="external">Schweizer Dokumentationsseite</a> und weitere direkt verlinkte SDI-Seiten sind die Quellen. Große Originaldateien werden über GitHub-Releases bereitgestellt; der Downloadort steht am jeweiligen Dokument. Fremdmaterial bleibt bis zur Rechteklärung ein Originalverweis. Geschützte und nicht erreichbare Dateien sind gekennzeichnet.</p><p>Die vorhandenen Urheberhinweise bleiben erhalten. Der Katalog nennt Abrufdatum und SHA-256-Prüfsumme geladener Dateien. Unbekannte Dokumentjahre sind ausdrücklich als solche ausgewiesen.</p></details></div>
<form class="filter-bar" id="download-filters" role="search" aria-label="Dokumente suchen"><div><label for="document-search">Dokument suchen</label><input type="search" id="document-search" name="q" placeholder="Titel, Stichwort oder Jahr …" autocomplete="off"/></div><div><label for="document-category">Kategorie</label><select id="document-category" name="category"><option value="">Alle Kategorien</option>{categories.map(c=><option value={c}>{c}</option>)}</select></div><div><label for="document-language">Sprache</label><select id="document-language" name="language"><option value="">Alle Sprachen</option>{languageCodes.map(c=><option value={c}>{languageName(c)}</option>)}</select></div></form>
<div class="results-line"><p id="document-count" role="status" aria-live="polite">{catalog.length} Dokumente</p><button class="reset-button" id="reset-filters" type="button">Filter zurücksetzen</button></div><noscript><p>Ohne JavaScript sehen Sie den vollständigen Katalog. Die Browsersuche hilft beim Finden eines Titels.</p></noscript>
<div class="document-list">{catalog.map(doc=><article id={doc.id} class="document-row" data-title={[doc.title,doc.category,languageName(doc.language),doc.year||'',doc.filename].join(' ')} data-category={doc.category} data-language={doc.language}><span class="file-icon" aria-hidden="true">{doc.format}</span><div><h2>{doc.title}</h2><div class="document-meta"><span>{doc.category}</span><span>{languageName(doc.language)}</span><span>{doc.year?'Dokumentstand '+doc.year:'Jahr nicht angegeben'}</span><span>{size(doc.sizeBytes)}</span></div>{(doc.availability==='source-only'||doc.availability==='release-pending')&&<p class="document-warning">{doc.availability==='source-only'?'Originalverweis · Übernahme bis zur Rechte-/Eignungsklärung zurückgestellt.':'Großes Original · derzeit bei SDI Schweiz verfügbar.'}</p>}{doc.availability==='protected'&&<p class="document-warning">Passwortgeschütztes Dokument. Nicht übernommen; Zugang bei SDI Schweiz erfragen.</p>}{doc.availability==='unavailable'&&<p class="document-warning">Beim Abruf am {doc.retrievedAt} nicht verfügbar (HTTP {doc.httpStatus}). Kein lokaler Download.</p>}<details><summary>Quelle, Fassung und Prüfsumme</summary><p><a href={doc.originalUrl} rel="external">Originalquelle bei SDI Schweiz</a> · {doc.retrievedAt?'Abruf '+doc.retrievedAt:'Inventarisiert am 27.11.2026; nicht abgerufen'} · {doc.variant}</p>{doc.versionNote&&<p>{doc.versionNote}</p>}{doc.sha256&&<p>SHA-256: <code>{doc.sha256}</code></p>}{doc.duplicateOf&&<p>Inhaltsgleiche Datei: <a href={'#'+doc.duplicateOf}>{doc.duplicateOf}</a></p>}{doc.relatedIds.length>0&&<p>Weitere Fassungen: {doc.relatedIds.map((id,index)=><Fragment>{index>0?', ':''}<a href={'#'+id}>{catalog.find(d=>d.id===id)?.title||id}</a></Fragment>)}</p>}<p>{doc.rights}</p></details></div>{!['protected','unavailable'].includes(doc.availability)?<a class="button button-secondary document-action" href={doc.availability==='local'?url(doc.localHref):doc.downloadUrl} download={doc.availability==='local'?doc.filename:undefined} rel={doc.availability==='local'?undefined:'external'} aria-label={doc.title+' – '+location(doc)}>{doc.availability==='local'?'Herunterladen':doc.availability==='release'?'Bei GitHub laden':'Original öffnen'}</a>:<span class="document-action">{location(doc)}</span>}</article>)}</div><p id="no-documents" class="empty-state" hidden>Keine passenden Dokumente gefunden. Versuchen Sie einen anderen Suchbegriff oder setzen Sie die Filter zurück.</p>
<div class="notice"><strong>Fachliche Hinweise</strong><p>Der Archivbestand ersetzt keine aktuelle fachliche Prüfung. Die Bereitstellung dokumentiert vorhandene Materialien und ist keine Bestätigung ihrer heutigen medizinischen Gültigkeit.</p></div>
</section>
<script>
const search=document.querySelector<HTMLInputElement>('#document-search')!;
const category=document.querySelector<HTMLSelectElement>('#document-category')!;
const language=document.querySelector<HTMLSelectElement>('#document-language')!;
const rows=[...document.querySelectorAll<HTMLElement>('.document-row')];
const normalize=(s:string)=>s.toLocaleLowerCase('de').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
function update(){const terms=normalize(search.value.trim()).split(/\s+/).filter(Boolean);let count=0;rows.forEach(row=>{const visible=terms.every(term=>normalize(row.dataset.title||'').includes(term))&&(!category.value||row.dataset.category===category.value)&&(!language.value||row.dataset.language===language.value);row.hidden=!visible;if(visible)count++;});document.querySelector('#document-count')!.textContent=count+' von '+rows.length+' Dokumenten';document.querySelector<HTMLElement>('#no-documents')!.hidden=count!==0;}
search.addEventListener('input',update);category.addEventListener('change',update);language.addEventListener('change',update);
document.querySelector('#download-filters')!.addEventListener('submit',event=>event.preventDefault());
document.querySelector('#reset-filters')!.addEventListener('click',()=>{search.value='';category.value='';language.value='';update();search.focus();});
</script></Base>
