---
import Base from '../layouts/Base.astro';import {url,mail} from '../lib/paths.js';import site from '../data/site.json';import projects from '../data/projects.json';
---
<Base title="Mitmachen"><section class="page-heading"><div class="container"><div class="breadcrumb"><a href={url()}>Start</a><span>/</span>Mitmachen</div><p class="eyebrow">Wissen und Zeit einbringen</p><h1>Gemeinsam etwas<br/>weitergeben.</h1><p class="lead">Sie möchten Ihre Erfahrung für ein Projekt einbringen? Der erste Schritt ist ein persönliches Gespräch über Ihre Möglichkeiten und den Bedarf vor Ort.</p></div></section><section class="container section"><div class="content-grid"><div class="prose"><h2>Eine Anfrage ist der Anfang.</h2><p>Schreiben Sie uns, für welches Projekt Sie sich interessieren, welche beruflichen Erfahrungen Sie mitbringen und welcher Zeitraum für Sie infrage kommt. Bitte schicken Sie zunächst keine Ausweis-, Gesundheits- oder anderen sensiblen Unterlagen mit.</p><p>Konkrete Anforderungen, Qualifikationen, Sprachkenntnisse, Vorbereitung und Rahmenbedingungen klären wir im persönlichen Austausch. Eine Anfrage ist noch keine Zusage für einen Einsatz.</p><div class="notice"><strong>Südsudan: Interesse an künftiger Mitarbeit.</strong><p>Das Vorhaben befindet sich in Vorbereitung. Bisher sind keine festen Einsatzplätze bestätigt.</p></div></div><aside class="sidebar-box"><h2>Direkt Kontakt aufnehmen</h2><p><a href={mail(site.email,'Anfrage zur Mitarbeit bei SDI Deutschland')}>{site.email}</a></p><button class="copy-button" data-copy={site.email}>E-Mail-Adresse kopieren</button><p class="source-note">Der Link öffnet Ihr E-Mail-Programm. Auf dieser Website werden keine Bewerbungen gespeichert.</p></aside></div><div class="steps"><article class="step"><h3>Kontakt aufnehmen</h3><p>Stellen Sie sich kurz vor und nennen Sie Ihr Wunschprojekt sowie Ihre Fragen.</p></article><article class="step"><h3>Möglichkeiten besprechen</h3><p>Gemeinsam klären wir Bedarf, Voraussetzungen und den möglichen zeitlichen Rahmen.</p></article><article class="step"><h3>Vorbereitung abstimmen</h3><p>Erst wenn die Mitarbeit konkret vereinbart ist, stimmen wir die nächsten Schritte mit Ihnen ab.</p></article></div><div class="contact-grid" style="margin-top:55px">{projects.map(project=><article class="contact-card"><p class="eyebrow">{project.status}</p><h2>{project.name}</h2><p>{project.slug==='suedsudan'?'Interesse für eine künftige Zusammenarbeit bekunden.':'Möglichkeiten einer Mitarbeit persönlich erfragen.'}</p><div class="actions"><a class="button button-secondary" href={mail(site.email,project.slug==='suedsudan'?'Interesse an künftiger Mitarbeit – Südsudan':'Anfrage zur Mitarbeit – '+project.name)}>Anfrage per E-Mail</a></div></article>)}</div></section></Base>
