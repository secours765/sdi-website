---
import { imageSize } from "../lib/images.js";
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Support from '../components/Support.astro';
import projects from '../data/projects.json';
import team from '../data/team.json';
import {url} from '../lib/paths.js';
---
<Base>
<section class="container hero"><div><p class="eyebrow">Secours Dentaire International</p><h1>Zahnmedizin<br/>verbindet.<br/><em>Menschen.</em></h1><p class="intro">Wir unterstützen zahnmedizinische Versorgung, Ausbildung und Vorsorge. Gemeinsam mit unseren Partnern vor Ort – für Hilfe, die weiterwächst.</p><div class="actions"><a class="button" href={url('projekte/')}>Unsere Projekte</a><a class="button button-secondary" href={url('spenden/')}>Spenden</a></div></div><figure class="hero-photo"><img src={url('images/uganda-gemeinschaft.webp')} srcset={url('images/uganda-gemeinschaft-800.webp')+' 800w, '+url('images/uganda-gemeinschaft.webp')+' '+imageSize('images/uganda-gemeinschaft.webp').width+'w'} sizes="(max-width: 620px) calc(100vw - 36px), (max-width: 1280px) 48vw, 620px" loading="eager" alt="Menschen kommen im Umfeld des Uganda-Projekts zu einer gemeinsamen Veranstaltung zusammen" {...imageSize('images/uganda-gemeinschaft.webp')} fetchpriority="high"/><div class="image-label"><strong>Gemeinsam vor Ort.</strong><span>Einblicke aus unserem Uganda-Projekt</span></div><figcaption class="hero-caption">Originalaufnahme aus dem Projektmaterial · Aufnahmejahr offen</figcaption></figure></section>
<section class="principles" aria-label="Unsere Schwerpunkte"><div class="container">
<div class="principle"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M11 4c-7-2-9 7-5 12 2 3 1 12 5 12 3 0 1-9 5-9s2 9 5 9c4 0 3-9 5-12 4-5 2-14-5-12-4 2-6 2-10 0Z"/></svg><div><strong>Versorgung ermöglichen</strong><span>Behandlung und Ausstattung</span></div></div>
<div class="principle"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m2 11 14-7 14 7-14 7-14-7Zm5 3v10c5 4 13 4 18 0V14M30 11v12"/></svg><div><strong>Wissen weitergeben</strong><span>Ausbildung und Zusammenarbeit</span></div></div>
<div class="principle"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16 28S3 21 3 12C3 3 13 2 16 9c3-7 13-6 13 3 0 9-13 16-13 16Z"/><path d="M8 16h5l2-5 3 10 2-5h5"/></svg><div><strong>Gesundheit stärken</strong><span>Vorsorge und Aufklärung</span></div></div>
</div></section>
<section class="container section"><div class="section-head"><div><p class="eyebrow">Unsere Projekte</p><h2>Persönlich verbunden.<br/>Gemeinsam wirksam.</h2></div><p>Zwei langjährige Partnerschaften und ein Vorhaben in Vorbereitung. Lernen Sie die Orte und ihre Geschichten kennen.</p></div><div class="project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section>
<section class="section section-soft"><div class="container split"><div><img src={url('images/uganda-solar.webp')} alt="Photovoltaikanlage auf dem Dach der Klinik in Mukono" loading="lazy" {...imageSize('images/uganda-solar.webp')}/><div class="history-preview"><strong>2013 bis heute</strong><p>Eine Partnerschaft, die Schritt für Schritt wächst.</p></div></div><div><p class="eyebrow">Die Geschichte hinter dem Projekt</p><h2>Aus Begegnung<br/>wird Entwicklung.</h2><p>Ein erster Kontakt in Mukono. Neue Behandlungsräume. Ein eigenes Labor. Solarstrom für die Klinik. Die Geschichte in Uganda zeigt, wie sich eine Zusammenarbeit über Jahre entwickelt.</p><p>Entdecken Sie die belegten Meilensteine und die Menschen und Orte dahinter.</p><a class="text-link" href={url('projekte/uganda/#geschichte')}>Die Entwicklung in Uganda entdecken</a></div></div></section>
<section class="container section"><div class="split"><div><p class="eyebrow">Wir über uns</p><h2>Engagement hat<br/>ein Gesicht.</h2><p>SDI Deutschland verbindet zahnmedizinisches Wissen mit persönlichem Einsatz. Unser Verein wurde am 22. Dezember 1999 gegründet und arbeitet mit SDI Schweiz zusammen.</p><a class="text-link" href={url('wir-ueber-uns/')}>Mehr über unseren Verein</a></div><div><p class="quote-free">Versorgung unterstützen.<br/>Wissen teilen.<br/>Partnerschaften pflegen.</p><div class="people-list">{team.map(person=><div class="person-compact"><strong>{person.name}</strong>{person.responsibility && <p>{person.responsibility}</p>}<p>{person.role}</p></div>)}</div></div></div><div class="downloads-callout"><div><p class="eyebrow">Wissen zugänglich machen</p><h3>Dokumente für die Arbeit vor Ort.</h3><p>Handbücher, Materialien zur Prophylaxe und Berichte aus dem Schweizer SDI-Archiv – geordnet und durchsuchbar.</p></div><a class="button button-secondary" href={url('downloads/')}>Dokumentation entdecken</a></div></section>
<Support/>
</Base>
